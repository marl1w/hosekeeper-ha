{
  "config": {
    "step": {
      "field": {
        "title": "The lawn",
        "description": "One entry per lawn. Size, place and what grows there decide how much water it loses and what the season asks of it.",
        "data": {
          "name": "Name",
          "area": "Area",
          "location": "Location",
          "exposure": "Sun exposure",
          "soil_type": "Soil",
          "grass_type": "Grass",
          "establishment_method": "How the lawn was made",
          "establishment_date": "When the lawn was made"
        },
        "data_description": {
          "location": "Used for the sun's path and the climate zone. Defaults to your home.",
          "exposure": "Full sun is six or more hours of direct light in summer.",
          "soil_type": "Squeeze a damp handful: sand falls apart, clay ribbons, loam holds and crumbles.",
          "grass_type": "Pick the closest match. A seed mix for temperate climates is a cool-season mix.",
          "establishment_method": "Sod roots in weeks and seed in a season, so the first year's care differs.",
          "establishment_date": "Leave empty if the lawn is older than a couple of years."
        }
      },
      "irrigation": {
        "title": "Irrigation",
        "description": "How water gets onto the grass. Hosekeeper converts minutes to millimetres with this, so advice can be given in the unit your timer understands.",
        "data": {
          "irrigation_type": "System",
          "flow_l_min": "Flow rate",
          "precipitation_rate_mm_h": "Precipitation rate",
          "valve_entity": "Valve or switch"
        },
        "data_description": {
          "flow_l_min": "Litres per minute for the whole field. Read it from the water meter during a run, or add up the nozzles.",
          "precipitation_rate_mm_h": "If you have measured it with catch cups, this wins over the flow rate.",
          "valve_entity": "Optional. Run time is logged automatically while it is on."
        }
      },
      "sources": {
        "title": "Weather and sensors",
        "description": "The forecast is required. Everything else is optional and, when present, replaces the forecast's estimate with what was measured.",
        "data": {
          "weather_entity": "Weather forecast",
          "rain_sensor": "Rain today",
          "temperature_sensor": "Temperature",
          "humidity_sensor": "Humidity",
          "wind_sensor": "Wind speed",
          "solar_sensor": "Solar radiation",
          "soil_moisture_sensor": "Soil moisture",
          "mower_entity": "Robot mower"
        },
        "data_description": {
          "rain_sensor": "A daily total that resets at midnight, or an ever-increasing total. Both are fine.",
          "solar_sensor": "With humidity and wind this enables the full FAO-56 evapotranspiration model.",
          "mower_entity": "Each mowing session is logged as a mow."
        }
      },
      "features": {
        "title": "Shade",
        "description": "Trees and structures that shade part of the lawn. Shade cuts water use but favours moss and disease, and trees compete for water and drop leaves. Leave everything at none if the lawn is in the open.",
        "data": {
          "feature_0_kind": "Feature 1",
          "feature_1_kind": "Feature 2",
          "feature_2_kind": "Feature 3",
          "feature_0_shade": "Share of lawn shaded by feature 1",
          "feature_1_shade": "Share of lawn shaded by feature 2",
          "feature_2_shade": "Share of lawn shaded by feature 3"
        },
        "data_description": {
          "feature_0_shade": "How much of the lawn sits in its shade for a good part of the day."
        }
      }
    },
